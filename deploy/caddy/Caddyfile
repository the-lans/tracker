{$DOMAIN} {
	# Заголовки безопасности (раздел 20.3). CSP разрешает только свой домен и
	# Google: вход (Google Identity Services) и шрифты; `'unsafe-inline'` в
	# style-src — для атрибутов `style` компонентов React. Сессия хранится
	# в HttpOnly cookie; CSP ограничивает посторонние скрипты. HSTS —
	# `HSTS_MAX_AGE` секунд (на локальном стенде 0: браузер иначе навсегда
	# переведёт localhost на https).
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age={$HSTS_MAX_AGE:31536000}"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# `handle_path` (не `reverse_proxy /api/*` напрямую) срезает совпавший
	# префикс `/api` перед проксированием — backend-роуты в `backend/main.py`
	# смонтированы БЕЗ префикса `/api` (`/tasks`, `/auth/google`, ...), см.
	# `frontend/src/lib/apiClient.ts`. `/ws/*` префикс не срезается — backend
	# монтирует WebSocket-канал буквально по пути `/ws/tasks/{id}/status`.
	handle_path /api/* {
		reverse_proxy backend:8000
	}
	reverse_proxy /ws/* backend:8000

	reverse_proxy frontend:80
}
