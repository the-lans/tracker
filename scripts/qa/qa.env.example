# Настройки стенда ручного E2E-тестирования (docs/qa_e2e_manual.md).
# Скопируйте в scripts/qa/qa.env (файл в .gitignore) и заполните:
#   cp scripts/qa/qa.env.example scripts/qa/qa.env
# `scripts/qa/stand.sh env` создаёт из него .env трекера, остальные
# секреты .env генерирует сам (openssl rand).

# === Секреты: только ваши значения, в репозиторий не попадают ===

# OAuth-клиент Google (Web application), в Authorized JavaScript origins —
# https://localhost; ваш e-mail — в тестовых пользователях приложения.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# === Параметры стенда ===

# Первый администратор: его e-mail добавляется в allowed_emails.
QA_ADMIN_EMAIL=admin@example.com

# Каталог LLM-аккаунта внутри volume claude_accounts — для `claude auth login`.
QA_CLAUDE_ACCOUNT_DIR=/data/claude-accounts/qa

# Compose-проект стенда (COMPOSE_PROJECT_NAME в .env): свои volume и сеть,
# не пересекаются с другим стеком трекера на этой машине.
QA_COMPOSE_PROJECT=tracker-qa

# Сеть compose-проекта, к которой подключаются qa-git и qa-mocks.
QA_NETWORK=tracker-qa_default

# Порт мока Jira/GitLab на хосте (журнал обращений: /_qa/requests).
QA_MOCKS_PORT=8090
