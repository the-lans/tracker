# Шаблон переменных окружения (раздел 20.3 ТЗ).
# На новом сервере копируется в .env скриптом deploy/install.sh (раздел 20.2, шаг 3):
# все секреты генерируются автоматически через `openssl rand`, кроме значений,
# явно запрашиваемых у администратора интерактивно (раздел 20.2, шаг 4).

# === Домен и TLS (интерактивный ввод, шаг 4) ===
# Домен, на котором доступен трекер; используется Caddy для маршрутизации и
# автоматического выпуска TLS-сертификата (раздел 20.2, шаг 10).
DOMAIN=tracker.example.com
# Email для выпуска TLS-сертификата (Let's Encrypt через Caddy).
ACME_EMAIL=admin@example.com

# === Google OAuth (единственный метод входа, раздел 19.1; интерактивный ввод, шаг 4) ===
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# === Ключ шифрования секретов (раздел 3.2, 19.4) ===
# Симметричный ключ для расшифровки значений env_variables.value_encrypted,
# repositories.deploy_key_encrypted, mcp_servers.auth_config_encrypted.
# Хранится только здесь, вне БД. Генерируется install.sh: `openssl rand -hex 32`.
SECRET_ENCRYPTION_KEY=

# === PostgreSQL (раздел 2.2 — основное хранилище данных) ===
# Пароль генерируется install.sh: `openssl rand -base64 24`.
POSTGRES_USER=tracker
POSTGRES_PASSWORD=
POSTGRES_DB=tracker

# === Redis (раздел 2.2 — брокер Celery, кеш, распределённые блокировки, pub/sub) ===
# Пароль (requirepass) генерируется install.sh: `openssl rand -base64 24`.
REDIS_PASSWORD=

# === Резервное копирование PostgreSQL (раздел 20.4) ===
# Расписание встроенного сервиса бэкапа (cron-выражение).
POSTGRES_BACKUP_CRON="0 3 * * *"
# Срок хранения бэкапов в днях.
POSTGRES_BACKUP_RETENTION_DAYS=14
