# Google OAuth Client ID для клиентского flow Google Identity Services
# (раздел 19.1 ТЗ) — ДОЛЖЕН совпадать с GOOGLE_OAUTH_CLIENT_ID backend'а
# (../.env.example): один и тот же OAuth-клиент, backend проверяет id_token
# по этому же audience. Публичный идентификатор — безопасно встраивается в
# бандл фронтенда (в отличие от GOOGLE_OAUTH_CLIENT_SECRET). Нужен только для
# `npm run dev`: образ из docker compose получает его из GOOGLE_OAUTH_CLIENT_ID
# корневого .env.
VITE_GOOGLE_CLIENT_ID=

# Базовый путь REST API. По умолчанию "/api" — проксируется Vite'ом в деве
# (vite.config.ts) и должен проксироваться реверс-прокси в проде (см.
# TODO про handle_path в deploy/caddy/Caddyfile).
VITE_API_BASE_URL=/api
